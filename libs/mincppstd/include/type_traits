    template <typename T>
    class reference_wrapper;

    namespace detail {
        template <typename T>
        struct member_pointer_class;

        template <typename Member, typename Class>
        struct member_pointer_class<Member Class::*> {
            using type = Class;
        };

        template <typename T>
        using member_pointer_class_t = typename member_pointer_class<T>::type;

        template <typename T>
        struct is_reference_wrapper : false_type {};

        template <typename T>
        struct is_reference_wrapper<reference_wrapper<T>> : true_type {};

        template <typename T>
        inline constexpr bool is_reference_wrapper_v = is_reference_wrapper<T>::value;

        template <typename MemberPointer, typename Object>
        inline constexpr bool is_member_object_instance_v =
            is_same_v<member_pointer_class_t<MemberPointer>, Object> ||
            is_base_of_v<member_pointer_class_t<MemberPointer>, Object>;

        // pointer-to-member function, reference_wrapper as object
        template <typename F, typename T, typename... Args>
            requires is_member_function_pointer_v<decay_t<F>>
        constexpr auto invoke_impl(F&& f, reference_wrapper<T> t, Args&&... args) noexcept(
            noexcept((t.get().*std::forward<F>(f))(std::forward<Args>(args)...)))
            -> decltype((t.get().*std::forward<F>(f))(std::forward<Args>(args)...)) {
            return (t.get().*std::forward<F>(f))(std::forward<Args>(args)...);
        }

        // pointer-to-member function, object instance
        template <typename F, typename T1, typename... Args>
            requires is_member_function_pointer_v<decay_t<F>> &&
                         is_member_object_instance_v<decay_t<F>, decay_t<T1>>
        constexpr auto invoke_impl(F&& f, T1&& t1, Args&&... args) noexcept(
            noexcept((std::forward<T1>(t1).*std::forward<F>(f))(std::forward<Args>(args)...)))
            -> decltype((std::forward<T1>(t1).*std::forward<F>(f))(std::forward<Args>(args)...)) {
            return (std::forward<T1>(t1).*std::forward<F>(f))(std::forward<Args>(args)...);
        }

        // pointer-to-member function, dereferenceable object
        template <typename F, typename T1, typename... Args>
            requires is_member_function_pointer_v<decay_t<F>> &&
                         (!is_member_object_instance_v<decay_t<F>, decay_t<T1>>) &&
                         (!is_reference_wrapper_v<decay_t<T1>>)
        constexpr auto invoke_impl(F&& f, T1&& t1, Args&&... args) noexcept(
            noexcept(((*std::forward<T1>(t1)).*std::forward<F>(f))(std::forward<Args>(args)...)))
            -> decltype(((*std::forward<T1>(t1)).*
                         std::forward<F>(f))(std::forward<Args>(args)...)) {
            return ((*std::forward<T1>(t1)).*std::forward<F>(f))(std::forward<Args>(args)...);
        }

        // pointer-to-data member, reference_wrapper as object
        template <typename F, typename T>
            requires is_member_object_pointer_v<decay_t<F>>
        constexpr auto invoke_impl(F&& f, reference_wrapper<T> t) noexcept(
            noexcept(t.get().*std::forward<F>(f))) -> decltype(t.get().*std::forward<F>(f)) {
            return t.get().*std::forward<F>(f);
        }

        // pointer-to-data member, object instance
        template <typename F, typename T1>
            requires is_member_object_pointer_v<decay_t<F>> &&
                         is_member_object_instance_v<decay_t<F>, decay_t<T1>>
        constexpr auto invoke_impl(F&& f, T1&& t1) noexcept(noexcept(std::forward<T1>(t1).*
                                                                     std::forward<F>(f)))
            -> decltype(std::forward<T1>(t1).*std::forward<F>(f)) {
            return std::forward<T1>(t1).*std::forward<F>(f);
        }

        // pointer-to-data member, dereferenceable object
        template <typename F, typename T1>
            requires is_member_object_pointer_v<decay_t<F>> &&
                         (!is_member_object_instance_v<decay_t<F>, decay_t<T1>>) &&
                         (!is_reference_wrapper_v<decay_t<T1>>)
        constexpr auto invoke_impl(F&& f, T1&& t1) noexcept(noexcept((*std::forward<T1>(t1)).*
                                                                     std::forward<F>(f)))
            -> decltype((*std::forward<T1>(t1)).*std::forward<F>(f)) {
            return (*std::forward<T1>(t1)).*std::forward<F>(f);
        }

        // general callable (non-member-pointer)
        template <typename F, typename... Args>
            requires(!is_member_pointer_v<decay_t<F>>)
        constexpr auto invoke_impl(F&& f, Args&&... args) noexcept(
            noexcept(std::forward<F>(f)(std::forward<Args>(args)...)))
            -> decltype(std::forward<F>(f)(std::forward<Args>(args)...)) {
            return std::forward<F>(f)(std::forward<Args>(args)...);
        }
    }  // namespace detail

    template <typename T>
    class reference_wrapper {
    private:
        T* __ptr;

    public:
        using type = T;

        constexpr explicit reference_wrapper(T& ref) noexcept : __ptr(&ref) {}
        constexpr reference_wrapper(T&&) = delete;

        constexpr reference_wrapper(const reference_wrapper&) noexcept            = default;
        constexpr reference_wrapper& operator=(const reference_wrapper&) noexcept = default;

        constexpr operator T&() const noexcept {
            return *__ptr;
        }

        constexpr T& get() const noexcept {
            return *__ptr;
        }

        template <typename... Args>
            requires requires(T& callable, Args&&... args) {
                detail::invoke_impl(callable, std::forward<Args>(args)...);
            }
        constexpr decltype(auto) operator()(Args&&... args) const
            noexcept(noexcept(detail::invoke_impl(get(), std::forward<Args>(args)...))) {
            return detail::invoke_impl(get(), std::forward<Args>(args)...);
        }
    };

    namespace detail {
        template <typename _Void, typename _Fp, typename... _Args>
        struct invoke_result_impl {};

        template <typename _Fp, typename... _Args>
        struct invoke_result_impl<
            void_t<decltype(detail::invoke_impl(declval<_Fp>(), declval<_Args>()...))>, _Fp,
            _Args...> {
            using type = decltype(detail::invoke_impl(declval<_Fp>(), declval<_Args>()...));
        };
    }  // namespace detail

    // invoke_result
    template <typename _Fp, typename... _Args>
    struct invoke_result : detail::invoke_result_impl<void, _Fp, _Args...> {};

    template <typename _Fp, typename... _Args>
    using invoke_result_t = typename invoke_result<_Fp, _Args...>::type;

    template <typename _Fp, typename... _Args>
