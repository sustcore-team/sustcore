    namespace detail {
        template <bool, typename _Fp, typename... _Args>
        struct is_nothrow_invocable_impl : false_type {};

        template <typename _Fp, typename... _Args>
        struct is_nothrow_invocable_impl<true, _Fp, _Args...>
            : bool_constant<noexcept(detail::invoke_impl(declval<_Fp>(), declval<_Args>()...))> {};
    }  // namespace detail

    template <typename _Fp, typename... _Args>
    struct is_nothrow_invocable
        : detail::is_nothrow_invocable_impl<is_invocable_v<_Fp, _Args...>, _Fp, _Args...> {};

    template <typename _Fp, typename... _Args>
    inline constexpr bool is_nothrow_invocable_v = is_nothrow_invocable<_Fp, _Args...>::value;

    namespace detail {
        template <typename _Rp>
        void invoke_r_sink(_Rp) noexcept;

        template <bool, typename _Rp, typename _Fp, typename... _Args>
        struct is_nothrow_invocable_r_impl : false_type {};

        template <typename _Rp, typename _Fp, typename... _Args>
        struct is_nothrow_invocable_r_impl<true, _Rp, _Fp, _Args...>
            : bool_constant<[]() consteval {
                if constexpr (is_void_v<_Rp>) {
                    return noexcept(detail::invoke_impl(declval<_Fp>(), declval<_Args>()...));
                } else {
                    return noexcept(detail::invoke_r_sink<_Rp>(
                        detail::invoke_impl(declval<_Fp>(), declval<_Args>()...)));
                }
            }()> {};
    }  // namespace detail

    template <typename _Rp, typename _Fp, typename... _Args>
    struct is_nothrow_invocable_r
        : detail::is_nothrow_invocable_r_impl<is_invocable_r_v<_Rp, _Fp, _Args...>, _Rp, _Fp,
                                              _Args...> {};

    template <typename _Rp, typename _Fp, typename... _Args>
    inline constexpr bool is_nothrow_invocable_r_v =
        is_nothrow_invocable_r<_Rp, _Fp, _Args...>::value;

    // 探测某个表达式是否有效(无效)
    template <typename _Default, template <typename...> class _Operation, typename... _Args>
    struct __detected_or {
