    template <typename... _Types>
    struct common_type;

    template <typename... _Types>
    using common_type_t = typename common_type<_Types...>::type;

    namespace detail {
        template <typename _Tp, typename _Up>
        using conditional_result_t = decltype(false ? declval<_Tp>() : declval<_Up>());

        template <typename _Tp, typename _Up, int _Priority = 1>
        struct common_type_decayed : common_type_decayed<_Tp, _Up, _Priority + 1> {};

        template <typename _Tp, typename _Up>
            requires requires { typename conditional_result_t<_Tp, _Up>; }
        struct common_type_decayed<_Tp, _Up, 1> {
            using type = decay_t<conditional_result_t<_Tp, _Up>>;
        };

        template <typename _Tp, typename _Up>
            requires requires { typename conditional_result_t<const _Tp&, const _Up&>; }
        struct common_type_decayed<_Tp, _Up, 2> {
            using type = remove_cvref_t<conditional_result_t<const _Tp&, const _Up&>>;
        };

        template <typename _Tp, typename _Up>
        struct common_type_decayed<_Tp, _Up, 3> {};

        template <typename _Tp, typename _Up,
                  bool = is_same_v<_Tp, decay_t<_Tp>> && is_same_v<_Up, decay_t<_Up>>>
        struct common_type_two : common_type<decay_t<_Tp>, decay_t<_Up>> {};

        template <typename _Tp, typename _Up>
        struct common_type_two<_Tp, _Up, true> : common_type_decayed<_Tp, _Up> {};
    }  // namespace detail

    template <>
    struct common_type<> {};

    template <typename _Tp>
    struct common_type<_Tp> : common_type<_Tp, _Tp> {};

    template <typename _Tp, typename _Up>
    struct common_type<_Tp, _Up> : detail::common_type_two<_Tp, _Up> {};

    template <typename _Tp, typename _Up, typename... _Rest>
        requires requires { typename common_type_t<_Tp, _Up>; }
    struct common_type<_Tp, _Up, _Rest...> : common_type<common_type_t<_Tp, _Up>, _Rest...> {};

    namespace detail {
        template <typename _From, typename _To>
        struct copy_cv {
        private:
            using _Const = conditional_t<is_const_v<_From>, add_const_t<_To>, _To>;

        public:
            using type = conditional_t<is_volatile_v<_From>, add_volatile_t<_Const>, _Const>;
        };

        template <typename _From, typename _To>
        using copy_cv_t = typename copy_cv<_From, _To>::type;

        template <typename _Tp, typename _Up, typename = void>
        struct common_ref_impl {};

        template <typename _Tp, typename _Up>
        using common_ref_t = typename common_ref_impl<_Tp, _Up>::type;

        template <typename _Xp, typename _Yp>
        using condres_cvref_t = conditional_result_t<copy_cv_t<_Xp, _Yp>&, copy_cv_t<_Yp, _Xp>&>;

        template <typename _Xp, typename _Yp>
        struct common_ref_impl<_Xp&, _Yp&, void_t<condres_cvref_t<_Xp, _Yp>>>
            : enable_if<is_reference_v<condres_cvref_t<_Xp, _Yp>>, condres_cvref_t<_Xp, _Yp>> {};

        template <typename _Xp, typename _Yp>
        using common_ref_rvalue_t = remove_reference_t<common_ref_t<_Xp&, _Yp&>>&&;

        template <typename _Xp, typename _Yp>
        struct common_ref_impl<
            _Xp&&, _Yp&&,
            enable_if_t<is_convertible_v<_Xp&&, common_ref_rvalue_t<_Xp, _Yp>> &&
                        is_convertible_v<_Yp&&, common_ref_rvalue_t<_Xp, _Yp>>>> {
            using type = common_ref_rvalue_t<_Xp, _Yp>;
        };

        template <typename _Xp, typename _Yp>
        using common_ref_mixed_t = common_ref_t<const _Xp&, _Yp&>;

        template <typename _Xp, typename _Yp>
        struct common_ref_impl<_Xp&&, _Yp&,
                               enable_if_t<is_convertible_v<_Xp&&, common_ref_mixed_t<_Xp, _Yp>>>> {
            using type = common_ref_mixed_t<_Xp, _Yp>;
        };

        template <typename _Xp, typename _Yp>
        struct common_ref_impl<_Xp&, _Yp&&> : common_ref_impl<_Yp&&, _Xp&> {};

        template <typename _Tp>
        struct xref {
            template <typename _Up>
            using type = copy_cv_t<_Tp, _Up>;
        };

        template <typename _Tp>
        struct xref<_Tp&> {
            template <typename _Up>
            using type = copy_cv_t<_Tp, _Up>&;
        };

        template <typename _Tp>
        struct xref<_Tp&&> {
            template <typename _Up>
            using type = copy_cv_t<_Tp, _Up>&&;
        };
    }  // namespace detail

    template <typename _Tp, typename _Up, template <typename> class _TQual,
              template <typename> class _UQual>
    struct basic_common_reference {};

    namespace detail {
        template <typename _Tp, typename _Up>
        using basic_common_ref_t =
            typename basic_common_reference<remove_cvref_t<_Tp>, remove_cvref_t<_Up>,
                                            xref<_Tp>::template type,
                                            xref<_Up>::template type>::type;
    }  // namespace detail

    template <typename... _Types>
    struct common_reference;

    template <typename... _Types>
    using common_reference_t = typename common_reference<_Types...>::type;

    template <>
    struct common_reference<> {};

    template <typename _Tp>
    struct common_reference<_Tp> {
        using type = _Tp;
    };

    namespace detail {
        template <typename _Tp, typename _Up, int _Priority = 1>
        struct common_reference_two : common_reference_two<_Tp, _Up, _Priority + 1> {};

        template <typename _Tp, typename _Up>
            requires is_reference_v<_Tp> && is_reference_v<_Up> &&
                     requires { typename common_ref_t<_Tp, _Up>; }
        struct common_reference_two<_Tp, _Up, 1> {
            using type = common_ref_t<_Tp, _Up>;
        };

        template <typename _Tp, typename _Up>
            requires requires { typename basic_common_ref_t<_Tp, _Up>; }
        struct common_reference_two<_Tp, _Up, 2> {
            using type = basic_common_ref_t<_Tp, _Up>;
        };

        template <typename _Tp, typename _Up>
            requires requires { typename conditional_result_t<_Tp, _Up>; }
        struct common_reference_two<_Tp, _Up, 3> {
            using type = conditional_result_t<_Tp, _Up>;
        };

        template <typename _Tp, typename _Up>
            requires requires { typename common_type_t<_Tp, _Up>; }
        struct common_reference_two<_Tp, _Up, 4> {
            using type = common_type_t<_Tp, _Up>;
        };

        template <typename _Tp, typename _Up>
        struct common_reference_two<_Tp, _Up, 5> {};
    }  // namespace detail

    template <typename _Tp, typename _Up>
    struct common_reference<_Tp, _Up> : detail::common_reference_two<_Tp, _Up> {};

    template <typename _Tp, typename _Up, typename... _Rest>
        requires requires { typename common_reference_t<_Tp, _Up>; }
    struct common_reference<_Tp, _Up, _Rest...>
        : common_reference<common_reference_t<_Tp, _Up>, _Rest...> {};

    template <typename _Tp>
    struct remove_pointer {
        using type = __remove_pointer(_Tp);
    };

    template <typename _Tp>
    using remove_pointer_t = typename remove_pointer<_Tp>::type;

    [[nodiscard]] __ATTR_ALWAYS_INLINE__ constexpr bool is_constant_evaluated() noexcept {
        return __builtin_is_constant_evaluated();
    }

}  // namespace std
