#pragma once

#include <concepts>
#include <cstddef>
#include <type_traits>
#include <utility>

namespace std {
    template <typename F, typename... Args>
        requires requires(F&& function, Args&&... args) {
            detail::invoke_impl(std::forward<F>(function), std::forward<Args>(args)...);
        }
    constexpr decltype(auto) invoke(F&& function, Args&&... args) noexcept(
        noexcept(detail::invoke_impl(std::forward<F>(function), std::forward<Args>(args)...))) {
        return detail::invoke_impl(std::forward<F>(function), std::forward<Args>(args)...);
    }

    template <typename R, typename F, typename... Args>
        requires is_invocable_r_v<R, F, Args...>
    constexpr R invoke_r(F&& function,
                         Args&&... args) noexcept(is_nothrow_invocable_r_v<R, F, Args...>) {
        if constexpr (is_void_v<R>) {
            std::invoke(std::forward<F>(function), std::forward<Args>(args)...);
        } else {
            return std::invoke(std::forward<F>(function), std::forward<Args>(args)...);
        }
    }

    struct identity {
        using is_transparent = void;

        template <typename T>
        [[nodiscard]]
        constexpr T&& operator()(T&& t) const noexcept {
            return std::forward<T>(t);
        }
    };

    template <class T = void>
    struct equal_to {
        [[nodiscard]]
        constexpr bool operator()(const T& left, const T& right) const
            noexcept(noexcept(left == right)) {
            return left == right;
        }
    };

    template <>
    struct equal_to<void> {
        using is_transparent = void;

        template <class T, class U>
        [[nodiscard]]
        constexpr auto operator()(T&& left, U&& right) const
            noexcept(noexcept(std::forward<T>(left) == std::forward<U>(right)))
                -> decltype(std::forward<T>(left) == std::forward<U>(right)) {
            return std::forward<T>(left) == std::forward<U>(right);
        }
    };

    namespace ranges {
        struct less {
            using is_transparent = void;

            template <class T, class U>
                requires totally_ordered_with<T, U>
            [[nodiscard]]
            constexpr bool operator()(T&& left, U&& right) const
                noexcept(noexcept(std::forward<T>(left) < std::forward<U>(right))) {
                if constexpr (is_pointer_v<remove_reference_t<T>> &&
                              is_pointer_v<remove_reference_t<U>>)
                {
                    if (std::is_constant_evaluated()) {
                        return std::forward<T>(left) < std::forward<U>(right);
                    }

                    using address_type = __UINTPTR_TYPE__;
                    return reinterpret_cast<address_type>(
                               static_cast<const volatile void*>(std::forward<T>(left))) <
                           reinterpret_cast<address_type>(
                               static_cast<const volatile void*>(std::forward<U>(right)));
                } else {
                    return std::forward<T>(left) < std::forward<U>(right);
                }
            }
        };
    }  // namespace ranges

    template <class T>
    struct hash;

    template <class T>
    struct __trival_hash {
        [[nodiscard]]
        constexpr size_t operator()(T value) const noexcept {
            return static_cast<size_t>(value);
        }
    };

    template <>
    struct hash<bool> : __trival_hash<bool> {};
    template <>
    struct hash<char> : __trival_hash<char> {};
    template <>
    struct hash<signed char> : __trival_hash<signed char> {};
    template <>
    struct hash<unsigned char> : __trival_hash<unsigned char> {};
    template <>
    struct hash<short> : __trival_hash<short> {};
    template <>
    struct hash<unsigned short> : __trival_hash<unsigned short> {};
    template <>
    struct hash<int> : __trival_hash<int> {};
    template <>
    struct hash<unsigned int> : __trival_hash<unsigned int> {};
    template <>
    struct hash<long> : __trival_hash<long> {};
    template <>
    struct hash<unsigned long> : __trival_hash<unsigned long> {};
    template <>
    struct hash<long long> : __trival_hash<long long> {};
    template <>
    struct hash<unsigned long long> : __trival_hash<unsigned long long> {};

    template <class T>
    struct hash<T*> {
        [[nodiscard]]
        size_t operator()(T* pointer) const noexcept {
            return reinterpret_cast<size_t>(pointer);
        }
    };
}  // namespace std
