/**
 * @file functional
 * @brief Minimal callable utilities.
 */

#pragma once

#include <type_traits>

namespace std {
    template <typename F, typename... Args>
        requires requires(F&& function, Args&&... args) {
            detail::invoke_impl(std::forward<F>(function),
                                std::forward<Args>(args)...);
        }
    constexpr decltype(auto) invoke(F&& function, Args&&... args) noexcept(
        noexcept(detail::invoke_impl(std::forward<F>(function),
                                     std::forward<Args>(args)...))) {
        return detail::invoke_impl(std::forward<F>(function),
                                   std::forward<Args>(args)...);
    }

    struct identity {
        template <typename T>
        [[nodiscard]]
        constexpr T&& operator()(T&& t) const noexcept {
            return std::forward<T>(t);
        }
    };
}  // namespace std
