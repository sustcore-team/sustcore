#pragma once

#include <cstddef>
#include <exception>

// Replaceable allocation and deallocation functions are provided by the
// freestanding runtime when dynamic allocation is enabled.
[[nodiscard]] void* operator new(size_t size);
[[nodiscard]] void* operator new[](size_t size);
namespace std {
    enum class align_val_t : size_t {};
    struct nothrow_t {
        explicit constexpr nothrow_t() = default;
    };
    inline constexpr nothrow_t nothrow{};
}  // namespace std
[[nodiscard]] void* operator new(size_t size, std::align_val_t alignment);
[[nodiscard]] void* operator new[](size_t size, std::align_val_t alignment);
[[nodiscard]] void* operator new(size_t size, const std::nothrow_t&) noexcept;
[[nodiscard]] void* operator new[](size_t size, const std::nothrow_t&) noexcept;
[[nodiscard]] void* operator new(size_t size, std::align_val_t alignment,
                                 const std::nothrow_t&) noexcept;
[[nodiscard]] void* operator new[](size_t size, std::align_val_t alignment,
                                   const std::nothrow_t&) noexcept;
void operator delete(void* ptr) noexcept;
void operator delete[](void* ptr) noexcept;
void operator delete(void* ptr, size_t size) noexcept;
void operator delete[](void* ptr, size_t size) noexcept;
void operator delete(void* ptr, std::align_val_t alignment) noexcept;
void operator delete[](void* ptr, std::align_val_t alignment) noexcept;
void operator delete(void* ptr, size_t size, std::align_val_t alignment) noexcept;
void operator delete[](void* ptr, size_t size, std::align_val_t alignment) noexcept;
void operator delete(void* ptr, const std::nothrow_t&) noexcept;
void operator delete[](void* ptr, const std::nothrow_t&) noexcept;
void operator delete(void* ptr, std::align_val_t alignment, const std::nothrow_t&) noexcept;
void operator delete[](void* ptr, std::align_val_t alignment, const std::nothrow_t&) noexcept;

// Placement new/delete
constexpr void* operator new(size_t size [[maybe_unused]], void* ptr) noexcept {
    return ptr;
}

constexpr void operator delete(void* ptr [[maybe_unused]], void*) noexcept {}

constexpr void* operator new[](size_t size [[maybe_unused]], void* ptr) noexcept {
    return ptr;
}

constexpr void operator delete[](void* ptr [[maybe_unused]], void*) noexcept {}

namespace std {
    template <typename T>
    [[nodiscard]] constexpr T* launder(T* p) noexcept {
        return __builtin_launder(p);
    }

#ifdef __EXCEPTIONS
    class bad_alloc : public exception {
    public:
        constexpr bad_alloc() noexcept                            = default;
        constexpr bad_alloc(const bad_alloc&) noexcept            = default;
        constexpr bad_alloc& operator=(const bad_alloc&) noexcept = default;
        constexpr bad_alloc(bad_alloc&&) noexcept                 = default;
        constexpr bad_alloc& operator=(bad_alloc&&) noexcept      = default;
        virtual ~bad_alloc() noexcept                             = default;

        [[nodiscard]]
        const char* what() const noexcept override {
            return "Failed at allocation";
        }
    };
#endif
}  // namespace std
