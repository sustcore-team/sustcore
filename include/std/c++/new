#pragma once

#include <cstddef>
#include <exception>

// Placement new/delete
constexpr void* operator new(size_t size [[maybe_unused]],
                             void* ptr) noexcept {
    return ptr;
}

constexpr void operator delete(void* ptr [[maybe_unused]],
                               void*) noexcept {}

constexpr void* operator new[](size_t size [[maybe_unused]],
                               void* ptr) noexcept {
    return ptr;
}

constexpr void operator delete[](void* ptr [[maybe_unused]],
                                 void*) noexcept {}

namespace std {
    template <typename T>
    [[nodiscard]] constexpr T* launder(T* p) noexcept {
        return __builtin_launder(p);
    }

#ifdef __EXCEPTIONS
    class bad_alloc : public exception {
    public:
        constexpr bad_alloc() noexcept = default;
        constexpr bad_alloc(const bad_alloc&) noexcept = default;
        constexpr bad_alloc& operator=(const bad_alloc&) noexcept = default;
        constexpr bad_alloc(bad_alloc&&) noexcept = default;
        constexpr bad_alloc& operator=(bad_alloc&&) noexcept = default;
        virtual ~bad_alloc() noexcept = default;

        [[nodiscard]]
        const char *what() const noexcept override {
            return "Failed at allocation";
        }
    };
#endif
}  // namespace std
